# Réglages du déploiement, lus par Docker Compose (docker-compose.yml).
# Sur le serveur : copier ce fichier en .env, à côté de docker-compose.yml, et adapter les valeurs.
# Inutile en développement.

# Domaine sur lequel l'application est servie
PISCORD_DOMAIN=piscord.example.com

# Réseau Docker de Traefik, sur lequel il joint les applications
PROXY_NETWORK=proxy

# Point d'entrée HTTPS de Traefik, et résolveur de certificats (laisser vide s'il n'y en a pas)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Images publiées par la chaîne de déploiement (.github/workflows/deploy.yml)
BACKEND_IMAGE=ghcr.io/williammcorreia/piscord-backend:latest
FRONTEND_IMAGE=ghcr.io/williammcorreia/piscord-frontend:latest
