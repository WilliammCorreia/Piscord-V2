# Copier ce fichier en .env et adapter les valeurs.

PORT=3000
MONGODB_URI=mongodb://mongodb:27017/piscord

# Secret de signature des access tokens (32 caractères aléatoires minimum).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changez-moi

# Secret dédié aux refresh tokens (optionnel : JWT_SECRET est utilisé par défaut).
# JWT_REFRESH_SECRET=changez-moi-aussi

# Origines autorisées en cross-origin, séparées par des virgules.
# Inutile derrière le reverse proxy (même origine) ; REVERSE_PROXY_ADDRESS reste accepté.
# CORS_ORIGINS=http://localhost:4200

# À passer à true dès que le site est servi en HTTPS.
COOKIE_SECURE=false
